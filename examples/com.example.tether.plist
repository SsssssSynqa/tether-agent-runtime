<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.example.tether</string>

  <key>ProgramArguments</key>
  <array>
    <string>/absolute/path/to/node</string>
    <string>/absolute/path/to/tether-agent-runtime/bin/tether-supervisor.cjs</string>
    <string>/absolute/path/to/private/config.json</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/absolute/path/to/tether-agent-runtime</string>

  <key>RunAtLoad</key>
  <true/>
  <!-- The Tether supervisor already owns bounded child restart. KeepAlive=false
       lets crash-loop exhaustion remain a visible stopped state. -->
  <key>KeepAlive</key>
  <false/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>Umask</key>
  <integer>63</integer>

  <key>StandardOutPath</key>
  <string>/absolute/path/to/private/logs/tether.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/absolute/path/to/private/logs/tether.stderr.log</string>
</dict>
</plist>
