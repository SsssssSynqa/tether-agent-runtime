# One root with folds/, cards/, and semantic/ subfolders.
TETHER_MEMORY_ROOT=./sample-data

# Optional overrides for existing/custom layouts.
# TETHER_FOLD_DIR=/absolute/path/to/folds
# TETHER_CARD_DIR=/absolute/path/to/cards
# TETHER_SEMANTIC_DIR=/absolute/path/to/semantic

# Serve the compiled single-file UI from the same local process.
TETHER_CONSOLE_STATIC_DIR=./frontend/dist
TETHER_CONSOLE_HOST=127.0.0.1
TETHER_CONSOLE_PORT=8431
