{
  "agent": {
    "id": "agent",
    "displayName": "Your Agent"
  },
  "owner": {
    "entityId": "owner",
    "displayName": "Owner",
    "telegramUserIds": []
  },
  "persona": {
    "policyFile": "./persona-policy.example.md"
  },
  "entities": [
    { "entityId": "owner", "canonicalDisplayName": "Owner", "type": "person" },
    { "entityId": "agent", "canonicalDisplayName": "Your Agent", "type": "ai" }
  ],
  "addressPolicy": {
    "canonicalOwnerName": "Owner",
    "disallowedOwnerNames": [],
    "preservedEntityNames": []
  },
  "storage": {
    "root": "./data"
  },
  "runtime": {
    "allowInitialSessionCreate": true,
    "rawTailMessages": 40,
    "maintenanceIntervalMs": 30000,
    "maintenanceActiveDelayMs": 250,
    "maintenanceErrorBaseDelayMs": 30000,
    "maintenanceErrorMaxDelayMs": 3600000
  },
  "memory": {
    "activeSoftTokenWatermark": 36000,
    "activeTargetTokenWatermark": 24000,
    "roundHardLimit": 120,
    "minimumRawTailRounds": 8,
    "summaryHistoryLimit": 64,
    "contextTokenBudget": 180000,
    "recentWeekCount": 4,
    "time": {
      "timezoneOffsetMinutes": 0,
      "cutoffHour": 6,
      "forceHour": 12,
      "quietMinutes": 45,
      "displayLabel": "configured local time"
    },
    "cards": {
      "enabled": true,
      "policy": "lossless"
    },
    "semantic": {
      "mode": "cards",
      "manifestMaxRecords": 50,
      "manifestMaxBytes": 8388608
    }
  },
  "telegram": {
    "enabled": false,
    "tokenEnv": "TELEGRAM_BOT_TOKEN",
    "allowedGroups": {},
    "noReplyGroupIds": [],
    "rateLimitedGroupIds": [],
    "rateLimitStateDir": "./data/telegram-rate-limit"
  },
  "providers": [
    {
      "id": "primary",
      "label": "Primary API",
      "adapter": "openai-compatible",
      "baseUrl": "https://api.example.invalid/v1/chat/completions",
      "apiKeyEnv": "PRIMARY_API_KEY",
      "model": "your-model-id",
      "foldModel": "your-fast-model-id",
      "memoryModel": "your-fast-model-id",
      "semanticExtractorModel": "your-fast-model-id",
      "semanticVerifierModel": "your-model-id",
      "semanticHighRiskModel": "your-model-id"
    }
  ]
}
